[Unit]
Description=MediaCMS API (Gunicorn)
After=network.target postgresql.service redis.service mediacms-migrations.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/home/mediacms.io/mediacms
Environment="PATH=/home/mediacms.io/bin"
ExecStart=/home/mediacms.io/bin/gunicorn cms.wsgi:application --config /home/mediacms.io/mediacms/config/gunicorn/gunicorn.conf.py --bind 127.0.0.1:8000
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=mediacms.target
