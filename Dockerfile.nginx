FROM nginx:alpine

LABEL org.opencontainers.image.title="MediaCMS Nginx"
LABEL org.opencontainers.image.description="Nginx server for MediaCMS"

# Copy nginx configurations
COPY config/nginx/nginx.conf /etc/nginx/nginx.conf
COPY config/nginx/site.conf /etc/nginx/conf.d/default.conf

# Create www-data user first
RUN addgroup -g 33 www-data 2>/dev/null || true && \
    adduser -D -u 33 -G www-data www-data 2>/dev/null || true

# Create directories for static and media files (will be volumes)
RUN mkdir -p /var/www/media /var/www/static /var/www/custom /var/log/mediacms && \
    chown -R www-data:www-data /var/www /var/log/mediacms

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
